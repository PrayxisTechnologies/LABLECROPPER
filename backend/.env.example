# LabelFlow Backend - Local Environment Configuration Template
PROJECT_NAME="LabelFlow API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Host & Port
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
API_V1_PREFIX="/api/v1"

# CORS Origins (Comma-separated)
ALLOWED_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# MongoDB Database Configuration
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"
MONGODB_DATABASE="labelflow"

# Authentication & JWT Configuration
AUTH_SECRET_KEY="generate-a-secure-random-secret-key-for-production"
AUTH_ALGORITHM="HS256"
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_NAME="labelflow_token"

# Upload Limits & Safeguards
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_FILES=10
ALLOWED_MIME_TYPES="application/pdf"
