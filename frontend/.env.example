# LabelFlow Frontend - Environment Configuration Template
# Copy to .env.local for local Next.js development

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Maximum client-side upload limit in MB (should align with backend setting)
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=50

# Maximum batch file count
NEXT_PUBLIC_MAX_FILES_COUNT=10
