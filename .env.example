# ==============================================================================
# LabelFlow - Global Environment Configuration Template
# Copy this file to .env or use corresponding backend/.env and frontend/.env.local
# Safe development configuration - contains NO real secrets.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True

# Backend Service Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Frontend Service Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Security & CORS (Comma-separated list of allowed origins)
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload & Processing Safeguards
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_FILES=10
ALLOWED_MIME_TYPES=application/pdf
TEMPORARY_STORAGE_DIR=temp/
OUTPUT_STORAGE_DIR=output/
